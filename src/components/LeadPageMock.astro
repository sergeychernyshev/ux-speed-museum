---
/**
 * Three mock pages for The Buried Lead exhibit, each with a different kind
 * of main content (the LCP element, marked with `.lead`):
 *  - product:  a large product photo
 *  - carousel: the first slide of a marketing carousel
 *  - headline: a text heading that waits for its web font
 *
 * All variants are pre-rendered; the exhibit shows one at a time.
 * Everything marked with `data-paint` renders right after first paint,
 * in the order of its value.
 */
interface Props {
  id: string;
  variant?: 'product' | 'carousel' | 'headline';
}

const { id, variant = 'product' } = Astro.props;
---

<div class="lead-pages" id={id}>
  <!-- Variant 1: product image -->
  <div class="lead-mock" data-variant="product" hidden={variant !== 'product'}>
    <nav class="mock-nav" data-paint="0">
      <div class="mock-logo">CHRONOS</div>
      <div class="mock-links">
        <span>Collections</span>
        <span>Sport</span>
        <span>Classic</span>
      </div>
      <div class="mock-cart">Cart (0)</div>
    </nav>
    <div class="product-layout">
      <div class="lead-frame product-frame" data-paint="1">
        <img
          src="/chronos.avif"
          alt="Chronos Elite Series 5 watch"
          class="lead"
          data-lead="image"
        />
      </div>
      <div class="product-info">
        <h3 class="product-title" data-paint="2">Chronos Elite Series 5</h3>
        <p class="product-price" data-paint="2">$1,299.00</p>
        <p class="product-text" data-paint="3">
          Automatic movement, sapphire crystal and 100m water resistance.
        </p>
        <button class="mock-button" data-paint="3" tabindex="-1">Buy Now</button
        >
      </div>
    </div>
    <footer class="mock-footer" data-paint="4">
      <span>Terms</span>
      <span>Privacy</span>
      <span>Support</span>
    </footer>
  </div>

  <!-- Variant 2: marketing carousel (first slide only, not interactive) -->
  <div
    class="lead-mock"
    data-variant="carousel"
    hidden={variant !== 'carousel'}
  >
    <nav class="mock-nav" data-paint="0">
      <div class="mock-logo">CHRONOS</div>
      <div class="mock-links">
        <span>Collections</span>
        <span>Sport</span>
        <span>Classic</span>
      </div>
      <div class="mock-cart">Cart (0)</div>
    </nav>
    <div class="lead-frame carousel-frame" data-paint="1">
      <img
        src="/chronos-campaign.avif"
        alt="New season campaign: Time, perfected. The Elite Series 5 has arrived."
        class="lead"
        data-lead="image"
      />
      <span class="carousel-arrow prev" aria-hidden="true">&lsaquo;</span>
      <span class="carousel-arrow next" aria-hidden="true">&rsaquo;</span>
      <div class="carousel-dots" aria-hidden="true">
        <span class="active"></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
    <div class="tiles">
      <div class="tile" data-paint="2">
        <strong>New Arrivals</strong>
        <span>Fresh this week</span>
      </div>
      <div class="tile" data-paint="3">
        <strong>Best Sellers</strong>
        <span>Customer favorites</span>
      </div>
      <div class="tile" data-paint="4">
        <strong>Gift Guide</strong>
        <span>Ideas for everyone</span>
      </div>
    </div>
    <footer class="mock-footer" data-paint="5">
      <span>Terms</span>
      <span>Privacy</span>
      <span>Support</span>
    </footer>
  </div>

  <!-- Variant 3: text heading waiting for its web font -->
  <div
    class="lead-mock"
    data-variant="headline"
    hidden={variant !== 'headline'}
  >
    <nav class="mock-nav" data-paint="0">
      <div class="mock-logo">THE DISPATCH</div>
      <div class="mock-links">
        <span>News</span>
        <span>Sports</span>
        <span>Culture</span>
      </div>
      <div class="mock-cart">Sign in</div>
    </nav>
    <article class="article">
      <div class="article-kicker" data-paint="1">Championship final</div>
      <h3 class="article-headline lead" data-lead="text">
        Harbor City Wins First Title in 40 Years
      </h3>
      <p class="article-standfirst" data-paint="2">
        A last-minute goal ends four decades of waiting and sends a whole city
        into the streets.
      </p>
      <div class="article-byline" data-paint="2">
        By Jordan Reyes • 4 min read
      </div>
      <p class="article-body" data-paint="3">
        With eleven seconds left on the clock and the score level at 2-2,
        captain Sam Okafor rose above two defenders to head home the winner,
        sealing a 3-2 victory in front of a sold-out crowd of 54,000.
      </p>
      <p class="article-body" data-paint="4">
        Fans who had not seen their team lift the trophy since 1986 poured onto
        the waterfront within minutes. A victory parade is planned for Saturday.
      </p>
    </article>
    <footer class="mock-footer" data-paint="5">
      <span>Terms</span>
      <span>Privacy</span>
      <span>Support</span>
    </footer>
  </div>
</div>

<style>
  .lead-pages {
    width: 100%;
  }

  .lead-mock {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    width: 100%;
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
    opacity: 0; /* Nothing before first paint */
  }

  .lead-mock[hidden] {
    display: none;
  }

  .lead-mock.visible {
    opacity: 1;
  }

  /* Painting: everything is laid out up front, then revealed in place */
  [data-paint] {
    opacity: 0;
  }

  [data-paint].painted {
    opacity: 1;
  }

  /* Shared chrome */
  .mock-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--sidebar-bg);
  }

  .mock-logo {
    font-weight: 900;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  .mock-links {
    display: flex;
    gap: 1rem;
    color: var(--muted-text);
    font-size: 0.7rem;
  }

  .mock-cart {
    font-size: 0.7rem;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .mock-links {
      display: none;
    }
  }

  .mock-footer {
    margin-top: auto;
    padding: 1rem;
    background: var(--sidebar-bg);
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    font-size: 0.6rem;
    color: var(--muted-text);
    border-top: 1px solid var(--border-color);
  }

  .mock-button {
    background: var(--accent-color);
    color: white;
    border: none;
    padding: 0.6rem;
    border-radius: 4px;
    font-weight: bold;
    pointer-events: none; /* Intentionally non-interactive */
  }

  /*
   * The lead frame reserves the full space of the main content from the
   * very first paint (no layout shift) - it just stays empty until the
   * image arrives.
   */
  .lead-frame {
    position: relative;
    background: var(--sidebar-bg);
    overflow: hidden;
  }

  .lead-frame img.lead {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 0 100% 0);
  }

  /* Variant 1: product */
  .product-layout {
    display: flex;
    flex-direction: column;
  }

  .product-frame {
    aspect-ratio: 16 / 10;
    max-height: 24rem;
    width: 100%;
    border-bottom: 1px solid var(--border-color);
  }

  .product-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.5rem 1.5rem;
  }

  .product-title {
    font-size: 1.25rem;
    margin: 0;
  }

  .product-price {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--accent-color);
  }

  .product-text {
    color: var(--muted-text);
    font-size: 0.8rem;
  }

  /* Variant 2: carousel */
  .carousel-frame {
    aspect-ratio: 2 / 1;
    max-height: 24rem;
    width: 100%;
  }

  /* Full screen: never crop the campaign text out of the banner */
  :global(.exhibit-stage.fullscreen) .carousel-frame {
    max-height: none;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--card-bg);
    color: var(--text-color);
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    line-height: 1;
    padding-bottom: 0.15rem;
  }

  .carousel-arrow.prev {
    left: 0.5rem;
  }

  .carousel-arrow.next {
    right: 0.5rem;
  }

  .carousel-dots {
    position: absolute;
    bottom: 0.6rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 0.4rem;
  }

  .carousel-dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--card-bg);
    border: 1px solid var(--muted-text);
  }

  .carousel-dots span.active {
    background: var(--accent-color);
    border-color: var(--accent-color);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    padding: 1rem;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 0.8rem;
  }

  .tile span {
    color: var(--muted-text);
    font-size: 0.7rem;
  }

  /* Variant 3: headline */
  .article {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .article-kicker {
    color: var(--accent-color);
    font-size: 0.7rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /*
   * Stands in for a custom display typeface. Its space is reserved, but the
   * text is invisible until the "font" arrives.
   */
  .article-headline {
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: clamp(2rem, 6cqi, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
    visibility: hidden;
  }

  .article-headline.painted {
    visibility: visible;
  }

  .lead-pages {
    container-type: inline-size;
  }

  .article-standfirst {
    font-size: 1rem;
    color: var(--muted-text);
  }

  .article-byline {
    font-size: 0.7rem;
    color: var(--muted-text);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .article-body {
    font-size: 0.85rem;
  }

  :global(.scrubbing) .lead-mock {
    opacity: 0 !important;
  }
</style>
